# Cloudflare Pages headers (ignored by GitHub Pages)
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self)
  Content-Security-Policy: frame-ancestors 'self'

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self' https://pedxoxpammnyfnizljyj.supabase.co https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY

/en/
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self' https://pedxoxpammnyfnizljyj.supabase.co https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY

/assets/*
  Cache-Control: public, max-age=86400

/assets/neon/*.webp
  Cache-Control: public, max-age=2592000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/app/assets/*
  Cache-Control: public, max-age=31536000, immutable

/.well-known/apple-app-site-association
  Content-Type: application/json

/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *

/p/*
  X-Robots-Tag: noindex, nofollow

# The app must never be framed by another site (clickjacking). frame-ancestors only works as a real header, not in the page's <meta> CSP.
/app/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# The service worker must be re-checked on every visit, so a fix reaches installed phones at once.
/app/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate

/app/admin*
  X-Robots-Tag: noindex, nofollow

/app/staff*
  X-Robots-Tag: noindex, nofollow

/app/owner*
  X-Robots-Tag: noindex, nofollow

/llms.txt
  Content-Type: text/plain; charset=utf-8
